{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/super-admin",
      "destination": "/super-admin/index.html"
    },
    {
      "source": "/super-admin/:path((?!assets/).*)",
      "destination": "/super-admin/index.html"
    },
    {
      "source": "/personel",
      "destination": "/personel/index.html"
    },
    {
      "source": "/personel/:path((?!assets/).*)",
      "destination": "/personel/index.html"
    },
    {
      "source": "/:isletmeSlug((?!personel|super-admin|uygulama|assets|gorseller|yasal)[a-zA-Z0-9-]+)",
      "destination": "/uygulama/index.html"
    },
    {
      "source": "/:isletmeSlug((?!personel|super-admin|uygulama|assets|gorseller|yasal)[a-zA-Z0-9-]+)/:path((?!assets/).*)",
      "destination": "/uygulama/index.html"
    }
  ]
}
